#!/usr/bin/env bash
# Verify local tools and optional environment readiness for migration work.

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=script/migration/_lib.sh
source "${SCRIPT_DIR}/_lib.sh"

require_cmd psql
require_cmd pg_dump
require_cmd pg_restore
require_cmd shasum
require_cmd python3
require_cmd curl

printf 'preflight: local database tools OK\n'

if [[ -n "${SOURCE_DATABASE_URL:-}" ]]; then
  assert_source_url "$SOURCE_DATABASE_URL"
  host="$(db_host "$SOURCE_DATABASE_URL")"
  db="$(db_name "$SOURCE_DATABASE_URL")"
  printf 'preflight: SOURCE_DATABASE_URL present (host=%s db=%s)\n' "$host" "$db"
else
  printf 'preflight: SOURCE_DATABASE_URL unset (ok for code-only work)\n'
fi

if [[ -n "${REHEARSAL_DATABASE_URL:-}" ]]; then
  assert_neon_url "$REHEARSAL_DATABASE_URL" "REHEARSAL_DATABASE_URL"
  printf 'preflight: REHEARSAL_DATABASE_URL looks like Neon form_calisthenics_app\n'
fi

if [[ -n "${TARGET_DATABASE_URL:-}" ]]; then
  assert_neon_url "$TARGET_DATABASE_URL" "TARGET_DATABASE_URL"
  printf 'preflight: TARGET_DATABASE_URL looks like Neon form_calisthenics_app\n'
fi

if [[ -n "${RENDER_BASE_URL:-}" ]]; then
  [[ "$RENDER_BASE_URL" == https://* ]] || die "RENDER_BASE_URL must be https://"
  printf 'preflight: RENDER_BASE_URL set\n'
fi

printf 'preflight: OK\n'
