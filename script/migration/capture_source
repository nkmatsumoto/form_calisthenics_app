#!/usr/bin/env bash
# Capture an independent custom-format dump of SOURCE_DATABASE_URL into BACKUP_DIR.
# Optionally downloads the latest Heroku managed backup when HEROKU_APP is set.

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=script/migration/_lib.sh
source "${SCRIPT_DIR}/_lib.sh"

require_cmd pg_dump
require_cmd pg_restore
require_cmd shasum

require_env SOURCE_DATABASE_URL
assert_source_url "$SOURCE_DATABASE_URL"

BACKUP_ROOT="$(default_backup_root)"
BACKUP_DIR="${BACKUP_DIR:-${BACKUP_ROOT}/$(timestamp_utc)}"
mkdir -p "$BACKUP_DIR"

DUMP_FILE="${BACKUP_DIR}/form-calisthenics-custom.dump"
LIST_FILE="${BACKUP_DIR}/form-calisthenics-custom.list"

printf 'capture_source: writing custom dump to %s\n' "$BACKUP_DIR"
# Prefer PostgreSQL 16 clients (Docker) so dumps restore cleanly onto Neon PG16.
if command -v docker >/dev/null 2>&1; then
  docker run --rm \
    -e SOURCE_DATABASE_URL \
    -v "${BACKUP_DIR}:/backup" \
    postgres:16 \
    bash -c 'set -euo pipefail
      pg_dump --format=custom --no-owner --no-acl --dbname="$SOURCE_DATABASE_URL" -f /backup/form-calisthenics-custom.dump
      pg_restore --list /backup/form-calisthenics-custom.dump > /backup/form-calisthenics-custom.list'
else
  pg_dump --format=custom --no-owner --no-acl \
    --dbname="$SOURCE_DATABASE_URL" \
    --file="$DUMP_FILE"
  pg_restore --list "$DUMP_FILE" > "$LIST_FILE"
fi

if [[ -n "${HEROKU_APP:-}" ]]; then
  require_cmd heroku
  printf 'capture_source: downloading latest Heroku managed backup for %s\n' "$HEROKU_APP"
  heroku pg:backups:download -a "$HEROKU_APP" -o "${BACKUP_DIR}/heroku-managed.dump"
fi

shasum -a 256 "$BACKUP_DIR"/* > "${BACKUP_DIR}/SHA256SUMS"

LABEL=source OUT_DIR="$BACKUP_DIR" SOURCE_DATABASE_URL="$SOURCE_DATABASE_URL" \
  "${SCRIPT_DIR}/inventory_database"

"${SCRIPT_DIR}/build_restore_list" \
  --list "$LIST_FILE" \
  --out "${BACKUP_DIR}/form-calisthenics-public-only.list"

printf 'capture_source: OK\n'
printf 'BACKUP_DIR=%s\n' "$BACKUP_DIR"
cat "${BACKUP_DIR}/SHA256SUMS"
