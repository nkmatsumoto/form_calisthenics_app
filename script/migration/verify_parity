#!/usr/bin/env bash
# Compare two inventory JSON files (or live SOURCE vs TARGET/REHEARSAL URLs).
# Exit nonzero on any mismatch in migrations, counts, sequences, constraints,
# indexes, or stable hashes.

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=script/migration/_lib.sh
source "${SCRIPT_DIR}/_lib.sh"

require_cmd python3

SOURCE_JSON="${SOURCE_JSON:-}"
TARGET_JSON="${TARGET_JSON:-}"
OUT_DIR="${OUT_DIR:-.}"
MODE="${MODE:-rehearsal}"

if [[ -z "$SOURCE_JSON" || -z "$TARGET_JSON" ]]; then
  require_cmd psql
  tmp_dir="$(mktemp -d)"
  trap 'rm -rf "$tmp_dir"' EXIT

  if [[ -z "$SOURCE_JSON" ]]; then
    require_env SOURCE_DATABASE_URL
    LABEL=source OUT_DIR="$tmp_dir" "${SCRIPT_DIR}/inventory_database" >/dev/null
    SOURCE_JSON="${tmp_dir}/source_inventory.json"
  fi

  if [[ -z "$TARGET_JSON" ]]; then
    case "$MODE" in
      rehearsal)
        require_env REHEARSAL_DATABASE_URL
        LABEL=rehearsal OUT_DIR="$tmp_dir" "${SCRIPT_DIR}/inventory_database" >/dev/null
        TARGET_JSON="${tmp_dir}/rehearsal_inventory.json"
        ;;
      target|production)
        require_env TARGET_DATABASE_URL
        LABEL=target OUT_DIR="$tmp_dir" "${SCRIPT_DIR}/inventory_database" >/dev/null
        TARGET_JSON="${tmp_dir}/target_inventory.json"
        ;;
      *)
        die "MODE must be rehearsal or target when TARGET_JSON is unset"
        ;;
    esac
  fi
fi

[[ -f "$SOURCE_JSON" ]] || die "SOURCE_JSON not found"
[[ -f "$TARGET_JSON" ]] || die "TARGET_JSON not found"
mkdir -p "$OUT_DIR"

export VERIFY_SOURCE_JSON="$SOURCE_JSON"
export VERIFY_TARGET_JSON="$TARGET_JSON"
export VERIFY_OUT_DIR="$OUT_DIR"

python3 <<'PY'
import json, os, sys
from pathlib import Path

source = json.loads(Path(os.environ["VERIFY_SOURCE_JSON"]).read_text())
target = json.loads(Path(os.environ["VERIFY_TARGET_JSON"]).read_text())
out_dir = Path(os.environ["VERIFY_OUT_DIR"])

checks = []
failed = False

def check(name, ok, detail=""):
    global failed
    status = "PASS" if ok else "FAIL"
    if not ok:
        failed = True
    checks.append({"name": name, "status": status, "detail": detail})
    suffix = f" — {detail}" if detail else ""
    print(f"{status}: {name}{suffix}")

check("migrations", source.get("migrations") == target.get("migrations"),
      f"source={len(source.get('migrations', []))} target={len(target.get('migrations', []))}")
check("table_set", set(source.get("tables", {})) == set(target.get("tables", {})),
      f"source_tables={sorted(source.get('tables', {}))} target_tables={sorted(target.get('tables', {}))}")

for table, count in sorted(source.get("tables", {}).items()):
    tcount = target.get("tables", {}).get(table)
    check(f"count:{table}", count == tcount, f"source={count} target={tcount}")

check("sequences", source.get("sequences") == target.get("sequences"))
check("foreign_keys", source.get("foreign_keys") == target.get("foreign_keys"))
check("indexes", source.get("indexes") == target.get("indexes"))
check("columns", source.get("columns") == target.get("columns"))
check("active_storage_aggregates",
      source.get("active_storage_aggregates") == target.get("active_storage_aggregates"),
      f"source={source.get('active_storage_aggregates')} target={target.get('active_storage_aggregates')}")
check("active_storage_keys_hash",
      source.get("active_storage_keys_hash") == target.get("active_storage_keys_hash"))

for key, value in sorted(source.get("stable_hashes", {}).items()):
    check(f"hash:{key}", value == target.get("stable_hashes", {}).get(key))

for key in ("counts_by_exercise_id", "counts_by_workout_id", "counts_by_user_id"):
    check(key, source.get(key) == target.get(key))

result = {
    "status": "FAIL" if failed else "PASS",
    "source_label": source.get("label"),
    "target_label": target.get("label"),
    "source_host": source.get("host"),
    "target_host": target.get("host"),
    "checks": checks,
}
json_path = out_dir / "parity_result.json"
md_path = out_dir / "parity_result.md"
json_path.write_text(json.dumps(result, indent=2) + "\n")

lines = [
    "# Parity result (sanitized)",
    f"Status: {result['status']}",
    f"Source: {result['source_label']} @ {result['source_host']}",
    f"Target: {result['target_label']} @ {result['target_host']}",
    "",
]
lines += [f"- {c['status']}: {c['name']}" + (f" ({c['detail']})" if c['detail'] else "") for c in checks]
md_path.write_text("\n".join(lines) + "\n")
print(md_path.read_text())
print(f"Wrote {json_path}")
sys.exit(1 if failed else 0)
PY
